  const existing = document.getElementById('__combinedAuditLauncher');
  if (existing) {
    existing.remove();
    return;
  }

  const host = document.createElement('div');
  host.id = '__combinedAuditLauncher';
  host.style.cssText = [
    'position:fixed','top:16px','right:16px','z-index:2147483647','width:360px',
    'max-width:calc(100vw - 32px)','max-height:calc(100vh - 32px)','overflow:auto',
    'background:#111','color:#fff','border:1px solid rgba(255,255,255,.18)',
    'border-radius:14px','box-shadow:0 16px 40px rgba(0,0,0,.35)','font:13px/1.45 system-ui,sans-serif'
  ].join(';');

  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (m) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  }[m]));

  host.innerHTML = `
    <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-bottom:1px solid rgba(255,255,255,.12)">
      <div>
        <div style="font-weight:700;font-size:14px">Combined audit runner</div>
        <div style="opacity:.72;font-size:12px">${AUDITS.length} bundled scripts</div>
      </div>
      <button data-action="close" style="all:unset;cursor:pointer;padding:6px 8px;border-radius:8px;background:rgba(255,255,255,.08)">✕</button>
    </div>
    <div style="padding:12px 14px 8px 14px;opacity:.86">
      These are your uploaded scripts merged into one launcher. Some checks open their own report windows, so allow popups on this page if needed.
    </div>
    <div style="display:flex;gap:8px;padding:0 14px 12px 14px;flex-wrap:wrap">
      <button data-action="run-all" style="all:unset;cursor:pointer;padding:8px 10px;border-radius:10px;background:#fff;color:#111;font-weight:700">Run all</button>
      <button data-action="copy-list" style="all:unset;cursor:pointer;padding:8px 10px;border-radius:10px;background:rgba(255,255,255,.1)">Copy names</button>
    </div>
    <div id="__combinedAuditList" style="padding:0 10px 12px 10px"></div>
    <div id="__combinedAuditStatus" style="padding:0 14px 14px 14px;opacity:.75;font-size:12px"></div>
  `;

  const list = host.querySelector('#__combinedAuditList');
  const status = host.querySelector('#__combinedAuditStatus');

  const setStatus = (msg) => {
    status.textContent = msg;
  };

  const runAudit = async (audit, idx) => {
    setStatus(`Running ${idx + 1}/${AUDITS.length}: ${audit.label}`);
    try {
      const fn = new Function(audit.source);
      const result = fn();
      if (result && typeof result.then === 'function') {
        await result;
      }
      return { ok: true, audit };
    } catch (error) {
      console.error(`Audit failed: ${audit.label}`, error);
      return { ok: false, audit, error };
    }
  };

  const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

  AUDITS.forEach((audit, idx) => {
    const row = document.createElement('div');
    row.style.cssText = 'display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:center;padding:8px;border-radius:10px;border:1px solid rgba(255,255,255,.08);margin-bottom:8px';
    row.innerHTML = `
      <div>
        <div style="font-weight:600">${esc(audit.label)}</div>
        <div style="opacity:.62;font-size:11px">Source file: ${esc(audit.id)}</div>
      </div>
      <button data-run="${idx}" style="all:unset;cursor:pointer;padding:6px 8px;border-radius:8px;background:rgba(255,255,255,.1)">Run</button>
      <button data-copy="${idx}" style="all:unset;cursor:pointer;padding:6px 8px;border-radius:8px;background:rgba(255,255,255,.06)">Copy</button>
    `;
    list.appendChild(row);
  });

  host.addEventListener('click', async (event) => {
    const btn = event.target.closest('button');
    if (!btn) return;

    const action = btn.getAttribute('data-action');
    if (action === 'close') {
      host.remove();
      return;
    }
    if (action === 'copy-list') {
      const text = AUDITS.map((a, i) => `${i + 1}. ${a.label} [${a.id}]`).join('\n');
      try {
        await navigator.clipboard.writeText(text);
        setStatus('Audit list copied to clipboard.');
      } catch {
        setStatus('Could not copy the audit list.');
      }
      return;
    }
    if (action === 'run-all') {
      let failures = 0;
      for (let i = 0; i < AUDITS.length; i++) {
        const res = await runAudit(AUDITS[i], i);
        if (!res.ok) failures += 1;
        await delay(120);
      }
      setStatus(failures ? `Finished with ${failures} failed audit(s). Check the console for details.` : 'All audits finished.');
      return;
    }

    const runIdx = btn.getAttribute('data-run');
    if (runIdx != null) {
      const res = await runAudit(AUDITS[Number(runIdx)], Number(runIdx));
      setStatus(res.ok ? `Finished: ${AUDITS[Number(runIdx)].label}` : `Failed: ${AUDITS[Number(runIdx)].label}`);
      return;
    }

    const copyIdx = btn.getAttribute('data-copy');
    if (copyIdx != null) {
      const audit = AUDITS[Number(copyIdx)];
      try {
        await navigator.clipboard.writeText(audit.source);
        setStatus(`Copied source for: ${audit.label}`);
      } catch {
        setStatus(`Could not copy source for: ${audit.label}`);
      }
    }
  });

  document.body.appendChild(host);
  setStatus('Ready.');
})();
