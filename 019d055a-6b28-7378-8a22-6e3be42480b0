    }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>Combined Accessibility Audit Report</h1>
    <div class="subline"><b>URL:</b> ${esc(location.href)}</div>

    <div class="summary">
      <div class="stat">
        <div class="n">${results.length}</div>
        <div class="l">Checks run</div>
      </div>
      <div class="stat">
