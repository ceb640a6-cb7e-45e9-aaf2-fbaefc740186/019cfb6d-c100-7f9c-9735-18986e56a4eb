        <div class="l">Failures</div>
      </div>
    </div>

    <div class="toc">
      ${results
        .map(
          (r, i) =>
            `<a href="#section-${i + 1}">${i + 1}. ${esc(r.title)}</a>`
        )
        .join("")}
    </div>

    ${results
      .map(
        (r, i) => `
          <div id="section-${i + 1}">
            ${sectionBox(r.title, r.badgeText, r.badgeClass, r.intro, r.body)}
          </div>
        `
      )
      .join("")}
  </div>
</body>
</html>`;

  const report = window.open("", "_blank");
  if (!report) {
    alert("Popup blocked. Please allow popups for this page and run the script again.");
    return;
  }

  report.document.open();
  report.document.write(reportHtml);
  report.document.close();
})();
