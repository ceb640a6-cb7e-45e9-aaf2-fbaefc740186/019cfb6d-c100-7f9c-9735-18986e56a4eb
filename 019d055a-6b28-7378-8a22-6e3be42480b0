    h1{font-size:28px;line-height:1.2;margin:0 0 8px}
    .subline{color:var(--muted);margin-bottom:18px;word-break:break-all}
    .summary{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:12px;
      margin:18px 0 24px;
    }
    .stat{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:14px;
      padding:14px;
      box-shadow:var(--shadow);
    }
    .stat .n{font-size:24px;font-weight:800}
    .stat .l{margin-top:4px;color:var(--muted)}
    .box{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:14px;
      padding:16px;
      margin-bottom:16px;
      box-shadow:var(--shadow);
    }
    .head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom:8px;
    }
